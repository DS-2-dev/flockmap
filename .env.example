# Optional. Free key from https://openrouteservice.org/dev/#/signup
# Without it, routing uses the public OSRM and Valhalla servers.
ORS_API_KEY=

# Recommended. Utah's state geocoder finds nearly every Utah street address (the
# free fallbacks miss many). Free key: https://developer.mapserv.utah.gov/self-service
# Make a *browser* key whose URL patterns cover the live site (and your dev URL),
# e.g. https://your-site.vercel.app/* and http://localhost:3000/*
NEXT_PUBLIC_UGRC_API_KEY=
